{
  "manifest_version": 3,
  "name": "QuizZy - Side Panel Quiz Assistant",
  "version": "1.0.0",
  "description": "On-demand read-only DOM extraction and side panel quiz solver with zero host-page mutation by default.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open QuizZy"
  }
}
