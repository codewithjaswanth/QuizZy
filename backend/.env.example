# Groq Cloud API Keys (free tier: https://console.groq.com/keys)
# Single key:
GROQ_API_KEY=
# Or multiple comma-separated keys for round-robin rotation:
GROQ_API_KEYS=

# OpenRouter API Keys (free tier: https://openrouter.ai/settings/keys)
# Single key:
OPENROUTER_API_KEY=
# Or multiple comma-separated keys for parallel hedged racing & 429 quarantine failover:
# OPENROUTER_API_KEYS=sk-or-v1-key1,sk-or-v1-key2,sk-or-v1-key3
OPENROUTER_API_KEYS=

# SearXNG Factual Search Fallback (local container or instance)
SEARXNG_URL=http://127.0.0.1:8080
SEARXNG_ENABLED=true
