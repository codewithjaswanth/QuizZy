# Virtual environment
.venv/
venv/
ENV/
env/

# Environment secrets & credentials (NEVER commit these)
backend/.env
backend/.env.*
!backend/.env.example
.env
.env.*
!.env.example
.env.local

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Databases
*.db
*.sqlite
*.sqlite3

# Evaluation output artifacts
eval/results/*.json
!eval/results/.gitkeep

# Runtime server logs and supervisor lockfile
backend/server.log
backend/server.err.log
backend/supervisor.lock
*.log

# IDE, Editor, & OS metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
